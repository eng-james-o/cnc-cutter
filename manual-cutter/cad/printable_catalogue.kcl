@settings(defaultLengthUnit = mm, kclVersion = 3.0)

// One of each distinct printable shape, separated for inspection, not a slicer-ready plate.
import guideBody from "guides.kcl"
import templateChord from "parameters.kcl"
import cableClip, collarHalf, enclosureBase, enclosureLid, forkCap, gripHalf, parkingSaddle, pcbCarrier, pinchGuard, pivotFork, pivotSaddleHalf, registrationBracket, springGuardHalf, terminalCarrier, upperAnchor from "printed.kcl"
sampleP01_pivot_fork = pivotFork()
  |> translate(x = 0mm, y = 0mm, global = true)
sampleP01_socket_cap = forkCap()
  |> translate(x = 280mm, y = 0mm, global = true)
sampleP02_pivot_saddle_half = pivotSaddleHalf()
  |> translate(x = 560mm, y = 0mm, global = true)
sampleP03_anchor_cap = collarHalf(length = 36mm)
  |> translate(x = 840mm, y = 0mm, global = true)
sampleP03_upper_anchor = upperAnchor()
  |> translate(x = 0mm, y = 200mm, global = true)
sampleP04_carrier_cap = collarHalf(length = 40mm)
  |> translate(x = 280mm, y = 200mm, global = true)
sampleP04_terminal_carrier = terminalCarrier()
  |> translate(x = 560mm, y = 200mm, global = true)
sampleP05_grip_half = gripHalf()
  |> translate(x = 840mm, y = 200mm, global = true)
sampleP05_pinch_guard = pinchGuard()
  |> translate(x = 0mm, y = 400mm, global = true)
sampleP06_spring_guard_half = springGuardHalf()
  |> translate(x = 280mm, y = 400mm, global = true)
sampleP07_root_guide = guideBody(chord = templateChord)
  |> translate(x = 560mm, y = 400mm, global = true)
sampleP07_tip_guide = guideBody(chord = templateChord)
  |> translate(x = 840mm, y = 400mm, global = true)
sampleP08_registration_bracket = registrationBracket()
  |> translate(x = 0mm, y = 600mm, global = true)
sampleP09_enclosure_base = enclosureBase()
  |> translate(x = 280mm, y = 600mm, global = true)
sampleP09_enclosure_lid = enclosureLid()
  |> translate(x = 560mm, y = 600mm, global = true)
sampleP09_pcb_carrier = pcbCarrier()
  |> translate(x = 840mm, y = 600mm, global = true)
sampleP10_cable_clip = cableClip()
  |> translate(x = 0mm, y = 800mm, global = true)
sampleP10_parking_saddle = parkingSaddle()
  |> translate(x = 280mm, y = 800mm, global = true)

    dia = 16mm,
    length = 40mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
    |> appearance(color = '#20272D')
}
export fn cableGland() {
  stock = tube(od = 18mm, id = 6mm, length = 22mm)
  flange = tube(od = 24mm, id = 6mm, length = 4mm)
  return union([stock, flange])
    |> appearance(color = '#22282D')
}
export fn templateClamp() {
  blank = block(
    w = 65mm,
    d = 18mm,
    h = 60mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  void = block(
    w = 52mm,
    d = 20mm,
    h = 38mm,
    x = -1mm,
    y = -1mm,
    z = 11mm,
  )
  cframe = subtract(blank, tools = void)
  screw = pin(
    dia = 6mm,
    length = 45mm,
    x = 18mm,
    y = 9mm,
    z = -10mm,
  )
  return union([cframe, screw])
    |> appearance(color = steelGrey)
}
export fn terminalBlock() {
  blank = block(
    w = 25mm,
    d = 18mm,
    h = 14mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  boreA = pinY(
    dia = 4mm,
    length = 20mm,
    x = 7mm,
    y = -1mm,
    z = 6mm,
  )
  boreB = pinY(
    dia = 4mm,
    length = 20mm,
    x = 18mm,
    y = -1mm,
    z = 6mm,
  )
  return subtract(blank, tools = [boreA, boreB])
    |> appearance(color = '#434D52')
}
// Helical spring reference: geometry is illustrative; not a spring-rate design.
export fn springCoil() {
  path = helix(
    axis = Z,
    radius = 8mm,
    length = 80mm,
    revolutions = 16,
    angleStart = 0deg,
  )
  s = sketch(on = XY) {
    c = circle(center = [0mm, 0mm], start = [0.6mm, 0mm])
  }
  coil = sweep(region(segments = [s.c]), path = path, translateProfileToPath = true)
    |> rotate(axis = Y, angle = 90deg, global = true)
    |> appearance(color = steelGrey)
  hide(s)
  hide(path)
  return coil
}
export fn springHook() {
  return tube(od = 13mm, id = 10.6mm, length = 1.2mm)
    |> rotate(axis = X, angle = 90deg, global = true)
    |> appearance(color = steelGrey)
}

export fn wingnut() {
  body = nut(dia = 5mm)
  wingA = block(
    w = 13mm,
    d = 4mm,
    h = 8mm,
    x = 3mm,
    y = -2mm,
    z = 0mm,
  )
  wingB = block(
    w = 13mm,
    d = 4mm,
    h = 8mm,
    x = -16mm,
    y = -2mm,
    z = 0mm,
  )
  return union([body, wingA, wingB])
    |> appearance(color = steelGrey)
}
export fn ringTerminal() {
  eye = tube(od = 12mm, id = 5.5mm, length = 1mm)
  tongue = block(
    w = 14mm,
    d = 6mm,
    h = 1mm,
    x = 3mm,
    y = -3mm,
    z = 0mm,
  )
  barrel = tube(od = 5mm, id = 2.5mm, length = 10mm)
    |> rotate(axis = Y, angle = 90deg, global = true)
    |> translate(x = 12mm, z = 2mm, global = true)
  return union([eye, tongue, barrel])
    |> appearance(color = steelGrey)
}
export fn fuseInsert() {
  glass = pin(
    dia = 5mm,
    length = 20mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  endA = pin(
    dia = 5.2mm,
    length = 4mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  endB = pin(
    dia = 5.2mm,
    length = 4mm,
    x = 0mm,
    y = 0mm,
    z = 16mm,
  )
  return union([glass, endA, endB])
    |> appearance(color = '#AFBAC0')
}

export fn adjusterBolt() {
  rod = pinX(
    dia = 5mm,
    length = 80mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  eye = tube(od = 12mm, id = 6mm, length = 4mm)
    |> rotate(axis = X, angle = 90deg, global = true)
    |> translate(x = -5mm, y = 2mm, global = true)
  return union([rod, eye])
    |> appearance(color = steelGrey)
}

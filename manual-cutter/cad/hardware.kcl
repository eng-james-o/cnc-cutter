@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import block, pin, pinX, pinY, tube from "primitives.kcl"
import pipeOD, pipeWall, armCut, pivotZ, pipeBottom, pivotSleeveBore, crossbarCut, steelGrey, pvcWhite, ceramicWhite from "parameters.kcl"
// Purchased components are dimensional reference models, not vendor certified.
export fn armPipe() {
  stock = tube(od = pipeOD, id = pipeOD - (2 * pipeWall), length = armCut)
  pivot = pinY(
    dia = pivotSleeveBore,
    length = pipeOD + 2mm,
    x = 0mm,
    y = -pipeOD / 2 - 1mm,
    z = pivotZ - pipeBottom,
  )
  return subtract(stock, tools = pivot)
    |> appearance(color = pvcWhite)
}
export fn crossbarPipe() {
  return tube(od = pipeOD, id = pipeOD - (2 * pipeWall), length = crossbarCut)
    |> appearance(color = pvcWhite)
}
// Internal flush plug alternative avoids interference with external carrier collars.
export fn endCap() {
  plug = pin(
    dia = pipeOD - (2 * pipeWall) - 0.2mm,
    length = 16mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  flange = pin(
    dia = pipeOD,
    length = 2mm,
    x = 0mm,
    y = 0mm,
    z = -1mm,
  )
  return union([plug, flange])
    |> appearance(color = pvcWhite)
}
export fn bolt(dia, length) {
  shank = pin(
    dia = dia,
    length = length,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  head = pin(
    dia = dia * 1.75,
    length = dia * 0.65,
    x = 0mm,
    y = 0mm,
    z = -dia * 0.65 + 0.1mm,
  )
  return union([shank, head])
    |> appearance(color = steelGrey)
}
export fn washer(id, od, thick) {
  return tube(od = od, id = id, length = thick)
    |> appearance(color = steelGrey)
}
export fn nut(dia) {
  s = sketch(on = XY) {
    a = line(start = [dia, 0mm], end = [dia / 2, dia * 0.8660254])
    b = line(start = [dia / 2, dia * 0.8660254], end = [-dia / 2, dia * 0.8660254])
    c = line(start = [-dia / 2, dia * 0.8660254], end = [-dia, 0mm])
    d = line(start = [-dia, 0mm], end = [-dia / 2, -dia * 0.8660254])
    e = line(start = [-dia / 2, -dia * 0.8660254], end = [dia / 2, -dia * 0.8660254])
    f = line(start = [dia / 2, -dia * 0.8660254], end = [dia, 0mm])
  }
  blank = extrude(region(segments = [s.a, s.b]), length = dia * 0.8)
  hide(s)
  bore = pin(
    dia = dia,
    length = dia,
    x = 0mm,
    y = 0mm,
    z = -0.1mm,
  )
  return subtract(blank, tools = bore)
    |> appearance(color = steelGrey)
}
// Ceramic isolates the central wire anchor from both mounting bolts/backing plate.
export fn ceramicAnchor() {
  blank = block(
    w = 48mm,
    d = 16mm,
    h = 40mm,
    x = -24mm,
    y = -8mm,
    z = 0mm,
  )
  mountA = pin(
    dia = 4.5mm,
    length = 42mm,
    x = -18mm,
    y = 0mm,
    z = -1mm,
  )
  mountB = pin(
    dia = 4.5mm,
    length = 42mm,
    x = 18mm,
    y = 0mm,
    z = -1mm,
  )
  anchor = pinY(
    dia = 4.5mm,
    length = 18mm,
    x = 0mm,
    y = -9mm,
    z = 5mm,
  )
  return subtract(blank, tools = [mountA, mountB, anchor])
    |> appearance(color = ceramicWhite)
}
export fn wireClamp() {
  stock = block(
    w = 12mm,
    d = 12mm,
    h = 10mm,
    x = -6mm,
    y = -6mm,
    z = -5mm,
  )
  wire = pinX(
    dia = 1mm,
    length = 14mm,
    x = -7mm,
    y = 0mm,
    z = 0mm,
  )
  screw = pin(
    dia = 3mm,
    length = 8mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  return subtract(stock, tools = [wire, screw])
    |> appearance(color = steelGrey)
}
export fn alligatorClip() {
  jawA = block(
    w = 35mm,
    d = 7mm,
    h = 2mm,
    x = 0mm,
    y = -3.5mm,
    z = -3mm,
  )
  jawB = block(
    w = 35mm,
    d = 7mm,
    h = 2mm,
    x = 0mm,
    y = -3.5mm,
    z = 1mm,
  )
  hinge = pinY(
    dia = 6mm,
    length = 9mm,
    x = 20mm,
    y = -4.5mm,
    z = 0mm,
  )
  return union([jawA, jawB, hinge])
    |> appearance(color = steelGrey)
}

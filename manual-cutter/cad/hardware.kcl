    d = 45mm,
    h = 18mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
    |> appearance(color = '#246947')
}
export fn barrelConnector() {
  body = tube(od = 12mm, id = 5.5mm, length = 20mm)
  flange = tube(od = 16mm, id = 5.5mm, length = 2mm)
  return union([body, flange])
    |> appearance(color = '#20272D')
}
export fn rockerSwitch() {

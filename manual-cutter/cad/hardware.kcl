    w = 17mm,
    d = 23mm,
    h = 2mm,
    x = -2mm,
    y = -2mm,
    z = 0mm,
  )
  body = block(
    w = 13mm,
    d = 19mm,
    h = 18mm,
    x = 0mm,
    y = 0mm,
    z = -16mm,
  )
  return union([flange, body])
    |> appearance(color = '#282C30')
}
export fn footPedal() {
  return block(
    w = 90mm,
    d = 65mm,
    h = 28mm,
    x = 0mm,

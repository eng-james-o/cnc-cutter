// Mechanically bolted thin metal FACE plate, not a printed contact strip.
// The full guide outline supplies retention area and two shared registration holes.
export fn guideEdge(chord) {
  profile = sketch(on = XY) {
    l0 = line(
      start = [
        -0.0750000000 * chord,
        0.1000000000 * chord
      ],
      end = [0.0 * chord, 0.1000000000 * chord],
    )
    l1 = line(
      start = [0.0 * chord, 0.1000000000 * chord],
      end = [
        0.0006852326 * chord,
        0.1046112590 * chord
      ],
    )
    l2 = line(
      start = [
        0.0006852326 * chord,
        0.1046112590 * chord
      ],
      end = [
        0.0027390523 * chord,
        0.1091144757 * chord
      ],
    )
    l3 = line(
      start = [

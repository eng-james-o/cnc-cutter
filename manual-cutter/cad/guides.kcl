        -0.0750000000 * chord,
        0.1000000000 * chord - edgeThickness
      ],
    )
  }
  blank = extrude(region(segments = [profile.l0, profile.l1]), length = templateThickness)
  hide(profile)
  holeA = pin(
    dia = 5.5mm,
    length = templateThickness + 2mm,
    x = 0.2 * chord,
    y = 0.035 * chord,
    z = -1mm,
  )
  holeB = pin(
    dia = 5.5mm,
    length = templateThickness + 2mm,
    x = 0.8 * chord,
    y = 0.035 * chord,
    z = -1mm,
  )
  return subtract(blank, tools = [holeA, holeB])
    |> appearance(color = printBlue)

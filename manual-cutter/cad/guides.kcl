@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import pin from "primitives.kcl"
import templateThickness, edgeThickness, printBlue from "parameters.kcl"
// NACA0012-derived UPPER tracing guide only; 60 chordwise samples.
// This demonstration profile is replaceable, not the user's final airfoil.
export fn guideBody(chord) {
  profile = sketch(on = XY) {
    l0 = line(
      start = [
        -0.0750000000 * chord,
        0.1000000000 * chord - edgeThickness

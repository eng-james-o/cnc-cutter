// CNC hot-wire cutter frame, engineering layout v0.1, not fabrication release.
// Open this file in Zoo Design Studio. All members are separate solid bodies.
@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import drilledRail from "drive_parts.kcl"
import carriageHolesZ, pin, pinX from "machining.kcl"
import stock, gusset from "parts.kcl"
import guideSeparation, linearTravel, railLength, towerHeight, baseDepth, profileNarrow, profileWide, towerOffset, railSpacing, carriageDepth, basePlateWidth, plateThickness, railHeight, blockHeight, endMargin, x1Position, x2Position, aluminium, steel, plateBlue from "parameters.kcl"

// World X spans the hot wire, Y is horizontal cutting travel, Z is vertical.
// Firmware X1/X2 move along world Y; firmware Y1/Y2 move along world Z.
towerCenter = guideSeparation / 2 + towerOffset
innerRail = towerCenter - (railSpacing / 2)
outerRail = towerCenter + railSpacing / 2
spanTieLength = 2 * innerRail - profileNarrow
shortTieLength = railSpacing - profileNarrow
baseTop = profileWide
railTop = baseTop + railHeight
plateBottom = railTop + blockHeight
footZ = plateBottom + plateThickness

braceRun = spanTieLength
braceRise = baseDepth - profileNarrow
braceLength = sqrt((braceRun / 1mm) ^ 2 + (braceRise / 1mm) ^ 2) * 1mm
braceAngle = atan2(y = braceRise, x = braceRun)

// Four 2040 bed beams, 40 mm dimension vertical.
leftInnerBed = stock(
  width = profileNarrow,
  depth = baseDepth,
  height = profileWide,
  x = -innerRail - (profileNarrow / 2),
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)
leftOuterBed = stock(
  width = profileNarrow,
  depth = baseDepth,
  height = profileWide,
  x = -outerRail - (profileNarrow / 2),
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)
rightInnerBed = stock(
  width = profileNarrow,
  depth = baseDepth,
  height = profileWide,
  x = innerRail - (profileNarrow / 2),
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)
rightOuterBed = stock(
  width = profileNarrow,
  depth = baseDepth,
  height = profileWide,
  x = outerRail - (profileNarrow / 2),
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)

// Span ties butt against inboard bed beams; short ties close each tower bed.
frontTie = stock(
  width = spanTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = -spanTieLength / 2,
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 42mm,
         x = -spanTieLength / 2 + 10mm * cos(braceAngle),
         y = -baseDepth / 2 + profileNarrow / 2 + 10mm * sin(braceAngle),
         z = -1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 42mm,
         x = spanTieLength / 2 - (10mm * cos(braceAngle)),
         y = -baseDepth / 2 + profileNarrow / 2 + 10mm * sin(braceAngle),
         z = -1mm,
       )
     ])
rearTie = stock(
  width = spanTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = -spanTieLength / 2,
  y = baseDepth / 2 - profileNarrow,
  z = 0mm,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 42mm,
         x = -spanTieLength / 2 + 10mm * cos(braceAngle),
         y = baseDepth / 2 - (profileNarrow / 2) - (10mm * sin(braceAngle)),
         z = -1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 42mm,
         x = spanTieLength / 2 - (10mm * cos(braceAngle)),
         y = baseDepth / 2 - (profileNarrow / 2) - (10mm * sin(braceAngle)),
         z = -1mm,
       )
     ])
centerFrontTie = stock(
  width = spanTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = -spanTieLength / 2,
  y = -120mm,
  z = 0mm,
  color = aluminium,
)
centerRearTie = stock(
  width = spanTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = -spanTieLength / 2,
  y = 100mm,
  z = 0mm,
  color = aluminium,
)
leftFrontTie = stock(
  width = shortTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = -outerRail + profileNarrow / 2,
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)
leftRearTie = stock(
  width = shortTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = -outerRail + profileNarrow / 2,
  y = baseDepth / 2 - profileNarrow,
  z = 0mm,
  color = aluminium,
)
rightFrontTie = stock(
  width = shortTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = innerRail + profileNarrow / 2,
  y = -baseDepth / 2,
  z = 0mm,
  color = aluminium,
)
rightRearTie = stock(
  width = shortTieLength,
  depth = profileNarrow,
  height = profileWide,
  x = innerRail + profileNarrow / 2,
  y = baseDepth / 2 - profileNarrow,
  z = 0mm,
  color = aluminium,
)

// Underside steel X straps resist base racking. Separate levels avoid overlap.
braceOne = stock(
  width = braceLength,
  depth = 20mm,
  height = 4mm,
  x = 0mm,
  y = -10mm,
  z = -4mm,
  color = steel,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 12mm,
         x = 10mm,
         y = 0mm,
         z = -10mm,
       ),
       pin(
         dia = 5.5mm,
         length = 12mm,
         x = braceLength - 10mm,
         y = 0mm,
         z = -10mm,
       )
     ])
  |> rotate(axis = Z, angle = braceAngle, global = true)
  |> translate(x = -spanTieLength / 2, y = -baseDepth / 2 + profileNarrow / 2, global = true)
braceTwo = stock(
  width = braceLength,
  depth = 20mm,
  height = 4mm,
  x = 0mm,
  y = -10mm,
  z = -8mm,
  color = steel,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 12mm,
         x = 10mm,
         y = 0mm,
         z = -10mm,
       ),
       pin(
         dia = 5.5mm,
         length = 12mm,
         x = braceLength - 10mm,
         y = 0mm,
         z = -10mm,
       )
     ])
  |> rotate(axis = Z, angle = -braceAngle, global = true)
  |> translate(x = -spanTieLength / 2, y = baseDepth / 2 - (profileNarrow / 2), global = true)

// Packing between the lower diagonal and the undersides of the two end ties.
leftRearBraceSpacer = stock(
  width = profileNarrow,
  depth = profileNarrow,
  height = 4mm,
  x = -spanTieLength / 2,
  y = baseDepth / 2 - profileNarrow,
  z = -4mm,
  color = steel,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 6mm,
         x = -spanTieLength / 2 + 10mm * cos(braceAngle),
         y = baseDepth / 2 - (profileNarrow / 2) - (10mm * sin(braceAngle)),
         z = -5mm,
       )
     ])
rightFrontBraceSpacer = stock(
  width = profileNarrow,
  depth = profileNarrow,
  height = 4mm,
  x = spanTieLength / 2 - profileNarrow,
  y = -baseDepth / 2,
  z = -4mm,
  color = steel,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 6mm,
         x = spanTieLength / 2 - (10mm * cos(braceAngle)),
         y = -baseDepth / 2 + profileNarrow / 2 + 10mm * sin(braceAngle),
         z = -5mm,
       )
     ])

// Four X-axis rail envelopes on top of the four bed beams.
leftRailInner = drilledRail(length = railLength, height = railHeight)
  |> translate(
       x = -innerRail - 6mm,
       y = -railLength / 2,
       z = baseTop,
       global = true,
     )
leftRailOuter = drilledRail(length = railLength, height = railHeight)
  |> translate(
       x = -outerRail - 6mm,
       y = -railLength / 2,
       z = baseTop,
       global = true,
     )
rightRailInner = drilledRail(length = railLength, height = railHeight)
  |> translate(
       x = innerRail - 6mm,
       y = -railLength / 2,
       z = baseTop,
       global = true,
     )
rightRailOuter = drilledRail(length = railLength, height = railHeight)
  |> translate(
       x = outerRail - 6mm,
       y = -railLength / 2,
       z = baseTop,
       global = true,
     )

// One 45 mm block per horizontal rail; minimum eight-block architecture.
leftShimInner = stock(
  width = 27mm,
  depth = 45mm,
  height = 8mm,
  x = -innerRail - 13.5mm,
  y = x1Position - 22.5mm,
  z = plateBottom - 8mm,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 3.4mm,
       length = 10mm,
       x = -innerRail,
       y = x1Position,
       z = plateBottom - 9mm,
     ))
leftBlockInner = stock(
  width = 27mm,
  depth = 45mm,
  height = blockHeight - 8mm,
  x = -innerRail - 13.5mm,
  y = x1Position - 22.5mm,
  z = railTop,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 2.5mm,
       length = 6mm,
       x = -innerRail,
       y = x1Position,
       z = railTop - 1mm,
     ))
leftShimOuter = stock(
  width = 27mm,
  depth = 45mm,
  height = 8mm,
  x = -outerRail - 13.5mm,
  y = x1Position - 22.5mm,
  z = plateBottom - 8mm,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 3.4mm,
       length = 10mm,
       x = -outerRail,
       y = x1Position,
       z = plateBottom - 9mm,
     ))
leftBlockOuter = stock(
  width = 27mm,
  depth = 45mm,
  height = blockHeight - 8mm,
  x = -outerRail - 13.5mm,
  y = x1Position - 22.5mm,
  z = railTop,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 2.5mm,
       length = 6mm,
       x = -outerRail,
       y = x1Position,
       z = railTop - 1mm,
     ))
rightShimInner = stock(
  width = 27mm,
  depth = 45mm,
  height = 8mm,
  x = innerRail - 13.5mm,
  y = x2Position - 22.5mm,
  z = plateBottom - 8mm,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 3.4mm,
       length = 10mm,
       x = innerRail,
       y = x2Position,
       z = plateBottom - 9mm,
     ))
rightBlockInner = stock(
  width = 27mm,
  depth = 45mm,
  height = blockHeight - 8mm,
  x = innerRail - 13.5mm,
  y = x2Position - 22.5mm,
  z = railTop,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 2.5mm,
       length = 6mm,
       x = innerRail,
       y = x2Position,
       z = railTop - 1mm,
     ))
rightShimOuter = stock(
  width = 27mm,
  depth = 45mm,
  height = 8mm,
  x = outerRail - 13.5mm,
  y = x2Position - 22.5mm,
  z = plateBottom - 8mm,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 3.4mm,
       length = 10mm,
       x = outerRail,
       y = x2Position,
       z = plateBottom - 9mm,
     ))
rightBlockOuter = stock(
  width = 27mm,
  depth = 45mm,
  height = blockHeight - 8mm,
  x = outerRail - 13.5mm,
  y = x2Position - 22.5mm,
  z = railTop,
  color = plateBlue,
)
  |> subtract(tools = carriageHolesZ(
       dia = 2.5mm,
       length = 6mm,
       x = outerRail,
       y = x2Position,
       z = railTop - 1mm,
     ))
leftBasePlate = stock(
  width = basePlateWidth,
  depth = carriageDepth,
  height = plateThickness,
  x = -towerCenter - (basePlateWidth / 2),
  y = x1Position - (carriageDepth / 2),
  z = plateBottom,
  color = plateBlue,
)
  |> subtract(tools = [
       pin(
         dia = 4.5mm,
         length = 10mm,
         x = -towerCenter - 19mm,
         y = x1Position,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 4.5mm,
         length = 10mm,
         x = -towerCenter + 19mm,
         y = x1Position,
         z = plateBottom - 1mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = -towerCenter - 10mm,
         y = x1Position + railSpacing / 2,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = -towerCenter + 10mm,
         y = x1Position + railSpacing / 2,
         z = plateBottom - 1mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = -towerCenter - 10mm,
         y = x1Position - (railSpacing / 2),
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = -towerCenter + 10mm,
         y = x1Position - (railSpacing / 2),
         z = plateBottom - 1mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -towerCenter - 13mm,
         y = x1Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -towerCenter - 13mm,
         y = x1Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -innerRail - 10mm,
         y = x1Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -innerRail - 10mm,
         y = x1Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -innerRail + 10mm,
         y = x1Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -innerRail + 10mm,
         y = x1Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -outerRail - 10mm,
         y = x1Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -outerRail - 10mm,
         y = x1Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -outerRail + 10mm,
         y = x1Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = -outerRail + 10mm,
         y = x1Position + 10mm,
         z = plateBottom - 1mm,
       )
     ])
rightBasePlate = stock(
  width = basePlateWidth,
  depth = carriageDepth,
  height = plateThickness,
  x = towerCenter - (basePlateWidth / 2),
  y = x2Position - (carriageDepth / 2),
  z = plateBottom,
  color = plateBlue,
)
  |> subtract(tools = [
       pin(
         dia = 4.5mm,
         length = 10mm,
         x = towerCenter - 19mm,
         y = x2Position,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 4.5mm,
         length = 10mm,
         x = towerCenter + 19mm,
         y = x2Position,
         z = plateBottom - 1mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = towerCenter - 10mm,
         y = x2Position + railSpacing / 2,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = towerCenter + 10mm,
         y = x2Position + railSpacing / 2,
         z = plateBottom - 1mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = towerCenter - 10mm,
         y = x2Position - (railSpacing / 2),
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 10mm,
         x = towerCenter + 10mm,
         y = x2Position - (railSpacing / 2),
         z = plateBottom - 1mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = towerCenter - 13mm,
         y = x2Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = towerCenter - 13mm,
         y = x2Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = innerRail - 10mm,
         y = x2Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = innerRail - 10mm,
         y = x2Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = innerRail + 10mm,
         y = x2Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = innerRail + 10mm,
         y = x2Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = outerRail - 10mm,
         y = x2Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = outerRail - 10mm,
         y = x2Position + 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = outerRail + 10mm,
         y = x2Position - 10mm,
         z = plateBottom - 1mm,
       ),
       pin(
         dia = 3.4mm,
         length = plateThickness + 2mm,
         x = outerRail + 10mm,
         y = x2Position + 10mm,
         z = plateBottom - 1mm,
       )
     ])

// Moving towers: paired 2040 uprights, 40 mm dimension across the wire.
leftUprightFront = stock(
  width = profileWide,
  depth = profileNarrow,
  height = towerHeight,
  x = -towerCenter - (profileWide / 2),
  y = x1Position - (railSpacing / 2) - (profileNarrow / 2),
  z = footZ,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter - 10mm,
         y = x1Position - (railSpacing / 2),
         z = footZ + towerHeight - 15mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter + 10mm,
         y = x1Position - (railSpacing / 2),
         z = footZ + towerHeight - 15mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter - 10mm,
         y = x1Position - (railSpacing / 2),
         z = footZ - 1mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter + 10mm,
         y = x1Position - (railSpacing / 2),
         z = footZ - 1mm,
       )
     ])
leftUprightRear = stock(
  width = profileWide,
  depth = profileNarrow,
  height = towerHeight,
  x = -towerCenter - (profileWide / 2),
  y = x1Position + railSpacing / 2 - (profileNarrow / 2),
  z = footZ,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter - 10mm,
         y = x1Position + railSpacing / 2,
         z = footZ + towerHeight - 15mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter + 10mm,
         y = x1Position + railSpacing / 2,
         z = footZ + towerHeight - 15mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter - 10mm,
         y = x1Position + railSpacing / 2,
         z = footZ - 1mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = -towerCenter + 10mm,
         y = x1Position + railSpacing / 2,
         z = footZ - 1mm,
       )
     ])
rightUprightFront = stock(
  width = profileWide,
  depth = profileNarrow,
  height = towerHeight,
  x = towerCenter - (profileWide / 2),
  y = x2Position - (railSpacing / 2) - (profileNarrow / 2),
  z = footZ,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter - 10mm,
         y = x2Position - (railSpacing / 2),
         z = footZ + towerHeight - 15mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter + 10mm,
         y = x2Position - (railSpacing / 2),
         z = footZ + towerHeight - 15mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter - 10mm,
         y = x2Position - (railSpacing / 2),
         z = footZ - 1mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter + 10mm,
         y = x2Position - (railSpacing / 2),
         z = footZ - 1mm,
       )
     ])
rightUprightRear = stock(
  width = profileWide,
  depth = profileNarrow,
  height = towerHeight,
  x = towerCenter - (profileWide / 2),
  y = x2Position + railSpacing / 2 - (profileNarrow / 2),
  z = footZ,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter - 10mm,
         y = x2Position + railSpacing / 2,
         z = footZ + towerHeight - 15mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter + 10mm,
         y = x2Position + railSpacing / 2,
         z = footZ + towerHeight - 15mm,
       )
     ])
  |> subtract(tools = [
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter - 10mm,
         y = x2Position + railSpacing / 2,
         z = footZ - 1mm,
       ),
       pin(
         dia = 4.2mm,
         length = 16mm,
         x = towerCenter + 10mm,
         y = x2Position + railSpacing / 2,
         z = footZ - 1mm,
       )
     ])
leftTopTie = stock(
  width = profileWide,
  depth = railSpacing + profileNarrow,
  height = profileNarrow,
  x = -towerCenter - (profileWide / 2),
  y = x1Position - ((railSpacing + profileNarrow) / 2),
  z = footZ + towerHeight,
  color = aluminium,
)
  |> subtract(tools = [
       pin(
         dia = 5.5mm,
         length = 22mm,
         x = -towerCenter - 10mm,
         y = x1Position + railSpacing / 2,
         z = footZ + towerHeight - 1mm,
       ),
       pin(
         dia = 5.5mm,
         length = 22mm,

// Four Y-axis rails face inward; carrier and guides appear in layout.kcl.
leftVerticalFront = drilledRail(length = railLength, height = railHeight)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> rotate(axis = Z, angle = 90deg, global = true)
  |> translate(
       x = -towerCenter + profileWide / 2,
       y = x1Position - (railSpacing / 2) - 6mm,
       z = footZ + endMargin,
       global = true,
     )
leftVerticalRear = drilledRail(length = railLength, height = railHeight)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> rotate(axis = Z, angle = 90deg, global = true)
  |> translate(
       x = -towerCenter + profileWide / 2,
       y = x1Position + railSpacing / 2 - 6mm,
       z = footZ + endMargin,
       global = true,
     )
rightVerticalFront = drilledRail(length = railLength, height = railHeight)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> rotate(axis = Z, angle = -90deg, global = true)
  |> translate(
       x = towerCenter - (profileWide / 2),
       y = x2Position - (railSpacing / 2) + 6mm,
       z = footZ + endMargin,
       global = true,
     )
rightVerticalRear = drilledRail(length = railLength, height = railHeight)
  |> rotate(axis = X, angle = 90deg, global = true)
  |> rotate(axis = Z, angle = -90deg, global = true)
  |> translate(
       x = towerCenter - (profileWide / 2),
       y = x2Position + railSpacing / 2 + 6mm,
       z = footZ + endMargin,
       global = true,
     )


leftGusset = gusset(
  x = -towerCenter - (profileWide / 2) - 6mm,
  y = x1Position,
  z = footZ,
  width = carriageDepth,
  height = 180mm,
  thickness = 6mm,
)
  |> subtract(tools = [
       pinX(
         dia = 5.5mm,

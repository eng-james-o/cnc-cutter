export fn coupler() {
  blank = pin(
    dia = 19mm,
    length = 25mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  lower = pin(
    dia = 8mm,
    length = 13.5mm,
    x = 0mm,
    y = 0mm,
    z = -1mm,
  )
  upper = pin(
    dia = 5mm,
    length = 14mm,
    x = 0mm,
    y = 0mm,
    z = 12mm,
  )
  upperTap = pinX(
    dia = 2.5mm,
    length = 10mm,
    x = 1mm,
    y = 0mm,
    z = 19mm,
  )
  lowerTap = pinX(
    dia = 2.5mm,
    length = 10mm,
    x = 1mm,
    y = 0mm,
    z = 6mm,
  )
  return subtract(blank, tools = [lower, upper, upperTap, lowerTap])
}


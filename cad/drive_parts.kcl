export fn wheel() {
  lower = tube(od = 15mm, id = 5mm, length = 1.5mm)
  rim = tube(od = 12.22mm, id = 5mm, length = 11mm)
    |> translate(z = 1.5mm, global = true)
  upper = tube(od = 15mm, id = 5mm, length = 1.5mm)
    |> translate(z = 12.5mm, global = true)
  return union([lower, rim, upper])
}

// Two side screws below the belt draw the jaw against the 9 mm-wide run.
// The vertical pair secures the fixed half to the moving carriage.
export fn beltClamp() {
  blank = block(
    w = 13.9mm,
    d = 32mm,
    h = 17mm,
    x = -8mm,
    y = -16mm,
    z = 0mm,
  )
  mountA = pin(
    dia = 3.4mm,
    length = 19mm,
    x = 0mm,
    y = -10mm,
    z = -1mm,
  )
  mountB = pin(
    dia = 3.4mm,
    length = 19mm,
    x = 0mm,
    y = 10mm,
    z = -1mm,
  )
  tapA = pinX(
    dia = 2.5mm,
    length = 9mm,
    x = -2mm,
    y = -7mm,
    z = 2.8mm,
  )
  tapB = pinX(
    dia = 2.5mm,
    length = 9mm,
    x = -2mm,
    y = 7mm,
    z = 2.8mm,
  )
  return subtract(blank, tools = [mountA, mountB, tapA, tapB])
}

export fn beltJaw() {
  blank = block(
    w = 4mm,
    d = 32mm,
    h = 15mm,
    x = 7.35mm,
    y = -16mm,
    z = 0mm,
  )
  a = pinX(
    dia = 3.4mm,
    length = 6mm,
    x = 6.35mm,
    y = -7mm,
    z = 2.8mm,
  )
  b = pinX(
    dia = 3.4mm,
    length = 6mm,
    x = 6.35mm,
    y = 7mm,
    z = 2.8mm,
  )
  return subtract(blank, tools = [a, b])
}


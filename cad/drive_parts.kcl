export fn drilledRail(length, height) {
  rail = block(
    w = 12mm,
    d = length,
    h = height,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  first = pin(
    dia = 3.5mm,
    length = height + 2mm,
    x = 6mm,
    y = 12.5mm,
    z = -1mm,
  )
  bores = patternLinear3d(
    first,
    instances = floor(length / 25mm),
    distance = 25mm,
    axis = Y,
  )
  counter = pin(
    dia = 6mm,
    length = 4.5mm,
    x = 6mm,
    y = 12.5mm,
    z = height - 3.5mm,
  )
  seats = patternLinear3d(
    counter,
    instances = floor(length / 25mm),
    distance = 25mm,
    axis = Y,
  )
  drilled = subtract(rail, tools = bores)
  return subtract(drilled, tools = seats)
    |> appearance(color = '#444E5C')
}

export fn wrap(radius, rear) {
  ring = tube(od = 2 * radius + 1.4mm, id = 2 * radius - 1.4mm, length = 9mm)
  cutter = block(
    w = 24mm,
    d = 12mm,
    h = 11mm,
    x = -12mm,
    y = -6mm - (rear * 6mm),
    z = -1mm,
  )
  return subtract(ring, tools = cutter)
}

export fn nutShelf(sign) {
  shelf = block(
    w = 41mm,
    d = 32mm,
    h = 6mm,
    x = -41mm,
    y = -16mm,
    z = -6mm,
  )
  nose = block(
    w = 16mm,
    d = 32mm,
    h = 6mm,
    x = 0mm,
    y = -16mm,
    z = -6mm,
  )
  base = union([shelf, nose])
  passage = pin(
    dia = 15mm,
    length = 8mm,
    x = 0mm,
    y = 0mm,
    z = -7mm,
  )
  a = pin(
    dia = 3.4mm,
    length = 8mm,
    x = -9mm,
    y = -10mm,
    z = -7mm,
  )
  b = pin(
    dia = 3.4mm,
    length = 8mm,
    x = -9mm,
    y = 10mm,
    z = -7mm,
  )
  c = pin(
    dia = 3.4mm,
    length = 8mm,
    x = 9mm,
    y = -10mm,
    z = -7mm,
  )
  e = pin(
    dia = 3.4mm,
    length = 8mm,
    x = 9mm,
    y = 10mm,
    z = -7mm,
  )
  f = pinX(
    dia = 2.5mm,
    length = 13mm,
    x = -42mm,
    y = 9mm,
    z = -3mm,
  )
  g = pinX(
    dia = 2.5mm,
    length = 13mm,
    x = -42mm,
    y = -9mm,
    z = -3mm,
  )
  return subtract(base, tools = [passage, a, b, c, e, f, g])
    |> rotate(axis = Z, angle = (1 - sign) * 90deg, global = true)
}

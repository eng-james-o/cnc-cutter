@settings(defaultLengthUnit = mm, kclVersion = 3.0)

import block, pin, tube, pinX from "machining.kcl"

export fn motorCase() {
  blank = block(
    w = 42.3mm,
    d = 42.3mm,
    h = 48mm,
    x = -21.15mm,
    y = -21.15mm,
    z = -48mm,
  )
  bore1 = pin(
    dia = 2.5mm,
    length = 5mm,
    x = -15.5mm,
    y = -15.5mm,
    z = -4.5mm,
  )
  bore2 = pin(
    dia = 2.5mm,
    length = 5mm,
    x = -15.5mm,
    y = 15.5mm,
    z = -4.5mm,
  )
  bore3 = pin(
    dia = 2.5mm,
    length = 5mm,
    x = 15.5mm,
    y = -15.5mm,
    z = -4.5mm,
  )
  bore4 = pin(
    dia = 2.5mm,
    length = 5mm,
    x = 15.5mm,
    y = 15.5mm,
    z = -4.5mm,
  )
  return subtract(blank, tools = [bore1, bore2, bore3, bore4])
}

export fn motor() {
  caseBody = motorCase()
  pilot = pin(
    dia = 22mm,
    length = 2mm,
    x = 0mm,
    y = 0mm,
    z = 0mm,
  )
  roundShaft = pin(
    dia = 5mm,
    length = 22mm,
    x = 0mm,
    y = 0mm,
    z = 2mm,
  )
  shaft = subtract(
    roundShaft,
    tools = block(
      w = 2mm,
      d = 6mm,
      h = 16mm,
      x = 2mm,
      y = -3mm,
      z = 9mm,
    ),
  )
  return union([caseBody, pilot, shaft])
    |> appearance(color = '#394652')
}

export fn beltBridge(spacing) {
  blank = block(
    w = spacing + 20mm,
    d = 44mm,
    h = 6mm,
    x = -spacing / 2 - 10mm,
    y = -22mm,
    z = 0mm,
  )
  bore1 = pin(
    dia = 3.4mm,
    length = 8mm,
    x = -15.5mm,
    y = -15.5mm,
    z = -1mm,
  )
  bore2 = pin(
    dia = 3.4mm,
    length = 8mm,
    x = -15.5mm,
    y = 15.5mm,
    z = -1mm,
  )
  bore3 = pin(
    dia = 3.4mm,
    length = 8mm,
    x = 15.5mm,
    y = -15.5mm,
    z = -1mm,
  )
  bore4 = pin(
    dia = 3.4mm,
    length = 8mm,
    x = 15.5mm,
    y = 15.5mm,
    z = -1mm,
  )
  bore5 = pin(
    dia = 22.5mm,
    length = 8mm,
    x = 0mm,
    y = 0mm,
    z = -1mm,
  )
  bore6 = pin(
    dia = 5.5mm,
    length = 8mm,
    x = -spacing / 2,
    y = -12mm,
    z = -1mm,
  )
  bore7 = pin(
    dia = 5.5mm,
    length = 8mm,
    x = -spacing / 2,
    y = 12mm,
    z = -1mm,
  )
  bore8 = pin(
    dia = 5.5mm,
    length = 8mm,
    x = spacing / 2,
    y = -12mm,
    z = -1mm,
  )
  bore9 = pin(
    dia = 5.5mm,
    length = 8mm,
    x = spacing / 2,
    y = 12mm,
    z = -1mm,
  )
  return subtract(
    blank,
    tools = [
      bore1,
      bore2,
      bore3,
      bore4,
      bore5,
      bore6,
      bore7,
      bore8,
      bore9
    ],
  )
}

